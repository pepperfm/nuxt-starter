{
  "name": "@pepper_fm/nuxt-starter",
  "version": "0.1.2",
  "description": "Interactive Nuxt starter: choose a UI, official modules and a self-hosted backend.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pepperfm-starter": "bin/starter.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun bin/starter.mjs",
    "test": "bun test ./test",
    "check": "bun scripts/check.mjs",
    "test:smoke": "bun scripts/smoke.mjs",
    "pub": "bun release.mjs",
    "verify": "bun release.mjs --check-only"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepperfm/nuxt-starter.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
